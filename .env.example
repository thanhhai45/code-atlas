# Copy to .env and adjust. docker compose reads .env automatically.

# A GitHub personal access token (no scopes needed for public data) raises the
# Search API limit from 10 to 30 requests/minute and the core limit to 5000/hour.
GITHUB_TOKEN=

# Crawler defaults used by `make crawl`
CRAWL_MIN_STARS=1000
CRAWL_MAX=10000

# Embeddings for semantic / hybrid search. docker compose sets this for the api
# and crawler; set it yourself when running them outside compose.
# EMBEDDINGS_URL=http://localhost:8000

# Elasticsearch outside compose. List several nodes, comma-separated, to spread
# requests and survive a node failure (e.g. the cluster from `make cluster-up`).
# ELASTICSEARCH_URL=http://localhost:9200,http://localhost:9201,http://localhost:9202
